# EVA v0.1.1
# Copia este archivo como .env y completa SOLO en tu PC.
# .env esta ignorado por Git y no debe subirse al repositorio.

EVA_LLM_PROVIDER=ollama
EVA_LLM_BASE_URL=http://127.0.0.1:11434
EVA_LLM_MODEL=qwen3:1.7b
EVA_LLM_TIMEOUT=120

EVA_DB_PROVIDER=mysql
EVA_DB_HOST=VPS_IP_AQUI
EVA_DB_PORT=3306
EVA_DB_NAME=eva_ai
EVA_DB_USER=eva_user
EVA_DB_PASSWORD=CAMBIA_ESTA_CLAVE
EVA_DB_CONNECT_TIMEOUT=10
