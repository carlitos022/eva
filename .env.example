# EVA v0.4.0
# Copia este archivo como .env y completa SOLO en tu PC.
# .env esta ignorado por Git y no debe subirse al repositorio.

EVA_LLM_PROVIDER=ollama
EVA_LLM_BASE_URL=http://127.0.0.1:11434
EVA_LLM_MODEL=qwen3:1.7b
EVA_LLM_TIMEOUT=120

EVA_DB_PROVIDER=mysql
EVA_DB_HOST=VPS_IP_AQUI
EVA_DB_PORT=3306
EVA_DB_NAME=eva_ai
EVA_DB_USER=eva_user
EVA_DB_PASSWORD=CAMBIA_ESTA_CLAVE
EVA_DB_CONNECT_TIMEOUT=10

# Contexto y memoria
EVA_RECENT_CONTEXT_LIMIT=8
EVA_LONG_TERM_MEMORY_LIMIT=6
EVA_MEMORY_SCAN_LIMIT=300
EVA_MEMORY_MIN_IMPORTANCE=0.55

# Memory Cortex v0.4
EVA_EMBEDDINGS_ENABLED=true
EVA_EMBEDDING_MODEL=bge-m3
EVA_EMBEDDING_TIMEOUT=30
EVA_EMBEDDING_RETRY_SECONDS=60
EVA_MEMORY_TREE_REBUILD_EVERY=5

# Archivist post-turn
EVA_ARCHIVIST_ENABLED=true
EVA_ARCHIVIST_MODEL=qwen3:1.7b
EVA_ARCHIVIST_TIMEOUT=120
EVA_ARCHIVIST_QUEUE_SIZE=32
EVA_ARCHIVIST_IDLE_DELAY=0.75

# Autonomia futura. En v0.4 se recomienda mantenerla apagada.
EVA_HEARTBEAT_ENABLED=false
EVA_HEARTBEAT_INTERVAL=60
EVA_AUTONOMY_ENABLED=false
